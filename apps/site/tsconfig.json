{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@pineappleui/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      // Keep in sync with `resolve.alias` in vite.config.ts — this is the same
      // mapping for the compiler, so that what tsc checks and what vite bundles
      // are the same files. src/alias-fences.test.ts asserts the two fences and
      // the manifest's devDependencies agree and cover every public package.
      // @pineappleui-aliases:start
      "@pineappleui/badge/*": ["../../packages/badge/src/*"],
      "@pineappleui/badge": ["../../packages/badge/src/index.ts"],
      "@pineappleui/box/*": ["../../packages/box/src/*"],
      "@pineappleui/box": ["../../packages/box/src/index.ts"],
      "@pineappleui/button/*": ["../../packages/button/src/*"],
      "@pineappleui/button": ["../../packages/button/src/index.ts"],
      "@pineappleui/card/*": ["../../packages/card/src/*"],
      "@pineappleui/card": ["../../packages/card/src/index.ts"],
      "@pineappleui/heading/*": ["../../packages/heading/src/*"],
      "@pineappleui/heading": ["../../packages/heading/src/index.ts"],
      "@pineappleui/icon-button/*": ["../../packages/icon-button/src/*"],
      "@pineappleui/icon-button": ["../../packages/icon-button/src/index.ts"],
      "@pineappleui/icons/*": ["../../packages/icons/src/*"],
      "@pineappleui/icons": ["../../packages/icons/src/index.ts"],
      "@pineappleui/inline/*": ["../../packages/inline/src/*"],
      "@pineappleui/inline": ["../../packages/inline/src/index.ts"],
      "@pineappleui/live-region/*": ["../../packages/live-region/src/*"],
      "@pineappleui/live-region": ["../../packages/live-region/src/index.ts"],
      "@pineappleui/stack/*": ["../../packages/stack/src/*"],
      "@pineappleui/stack": ["../../packages/stack/src/index.ts"],
      "@pineappleui/text/*": ["../../packages/text/src/*"],
      "@pineappleui/text": ["../../packages/text/src/index.ts"],
      "@pineappleui/text-area/*": ["../../packages/text-area/src/*"],
      "@pineappleui/text-area": ["../../packages/text-area/src/index.ts"],
      "@pineappleui/text-field/*": ["../../packages/text-field/src/*"],
      "@pineappleui/text-field": ["../../packages/text-field/src/index.ts"],
      "@pineappleui/theme/*": ["../../packages/theme/src/*"],
      "@pineappleui/theme": ["../../packages/theme/src/index.ts"],
      "@pineappleui/tokens/*": ["../../packages/tokens/src/*"],
      "@pineappleui/tokens": ["../../packages/tokens/src/index.ts"],
      "@pineappleui/use-local-storage/*": ["../../packages/use-local-storage/src/*"],
      "@pineappleui/use-local-storage": ["../../packages/use-local-storage/src/index.ts"]
      // @pineappleui-aliases:end
    }
  },
  // `scripts` covers the props-extraction fixtures (scripts/props-fixtures/*.tsx)
  // — the tricky prop shapes its unit test extracts from. They are real
  // TypeScript that has to keep compiling, and a fixture outside the project is
  // also a file the type-aware lint refuses to read. The `.mjs` scripts beside
  // them stay out: tsc reads `.ts`/`.tsx` only without `allowJs`.
  "include": ["src", "scripts", "vite.config.ts", "vitest.config.ts", "vite-env.d.ts"]
}
