{
  "name": "@pineappleui/site",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Reference site for @pineappleui — per-package docs, live examples and playgrounds, rendered from each package's own README, CHANGELOG and stories.",
  "scripts": {
    "dev": "npx turbo run build --filter=@pineappleui/theme && vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "pineapple": {
    "refTestNotApplicable": "An application, not a library: every component here is a page or chrome the site's own router mounts, nothing is exported for a consumer to import, and no component extends an element's props -- so there is no ref contract to break. The @pineappleui packages it renders prove their own ref forwarding in their own test suites."
  },
  "devDependencies": {
    "@pineappleui/badge": "*",
    "@pineappleui/box": "*",
    "@pineappleui/button": "*",
    "@pineappleui/card": "*",
    "@pineappleui/eslint-config": "*",
    "@pineappleui/heading": "*",
    "@pineappleui/icon-button": "*",
    "@pineappleui/icons": "*",
    "@pineappleui/inline": "*",
    "@pineappleui/live-region": "*",
    "@pineappleui/stack": "*",
    "@pineappleui/text": "*",
    "@pineappleui/text-area": "*",
    "@pineappleui/text-field": "*",
    "@pineappleui/theme": "*",
    "@pineappleui/tokens": "*",
    "@pineappleui/tsconfig": "*",
    "@pineappleui/use-local-storage": "*",
    "@pineappleui/vitest-preset": "*",
    "@radix-ui/themes": "^3.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.6.0",
    "remark-gfm": "^4.0.1",
    "typescript": "~5.7.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.2"
  }
}
