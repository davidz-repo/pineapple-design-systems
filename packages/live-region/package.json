{
  "name": "@pineappleui/live-region",
  "version": "0.1.1",
  "description": "LiveRegion primitive for @pineappleui — an audited aria-live announcement wrapper.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/davidz-repo/pineapple-design-system.git",
    "directory": "packages/live-region"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "pineapple": {
    "refTestNotApplicable": "LiveRegionProps is a hand-written list of seven props and `ref` is not one of them, so nothing reaches the element `as` names. That is deliberate: the contract this package enforces is that the region stays MOUNTED while its children change, and a consumer holding the node is not part of it."
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@pineappleui/eslint-config": "*",
    "@pineappleui/tsconfig": "*",
    "@pineappleui/vitest-preset": "*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "eslint": "^10.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "~5.7.2",
    "vitest": "^4.1.2"
  }
}
