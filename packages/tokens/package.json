{
  "name": "@pineappleui/tokens",
  "version": "0.0.0",
  "description": "Design tokens (accent colors, theme preference types) for @pineappleui.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/davidz-repo/pineapple-design-systems.git",
    "directory": "packages/tokens"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@pineappleui/eslint-config": "*",
    "@pineappleui/tsconfig": "*",
    "@pineappleui/vitest-preset": "*",
    "@types/node": "^22.10.0",
    "eslint": "^10.1.0",
    "tsup": "^8.3.0",
    "typescript": "~5.7.2",
    "vitest": "^4.1.2"
  }
}
