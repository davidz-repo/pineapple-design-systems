# Node / build output.
# No trailing slash on `node_modules` / `.turbo` so the symlinks git creates
# inside worktrees are ignored too (a trailing-slash pattern matches
# directories, not symlinks).
node_modules
dist/
**/dist/

# Ladle gallery production build output (`ladle build` -> apps/gallery/build/).
# Scoped to apps/ rather than a bare `build/`: every publishable package emits
# to dist/, and a repo-wide `build` pattern would also swallow a source folder
# of that name.
apps/*/build/

# The site's generated props tables (`apps/site/scripts/generate-props.mjs` ->
# apps/site/generated/props/<slug>.json, run by its `props` turbo task).
# Generated rather than committed on purpose: a committed copy is a second
# source of truth that goes stale between the commit changing a prop and the
# commit regenerating the table, and `scripts/check-token-drift.mjs` — which
# scans `git ls-files` for hard-coded token vocabularies and has no allowlist —
# would fail on the accent-colour unions these files write out verbatim.
# `scripts/check-props-coverage.mjs` is what fails when they are absent.
apps/site/generated/

# Turborepo local cache
.turbo
**/.turbo

.DS_Store
*.log

# Editor state. No `**/` twin: a pattern with no leading or middle slash already
# matches at every depth, so `.vscode` alone covers nested workspaces too.
.vscode

# Claude Code local state. `worktrees/` holds real git worktrees checked out
# inside the repo, so leaving `.claude/` unignored parks gigabytes of nested
# checkouts in `git status`. `settings.local.json` is per-machine, and today is
# only ignored via `~/.config/git/ignore` — which is per-clone and unversioned,
# so no fresh clone or collaborator inherits it.
# Scoped rather than a bare `.claude/`, to leave room for shared config later.
.claude/worktrees/
.claude/settings.local.json
