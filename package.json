{
  "name": "pineapple-design-systems",
  "private": true,
  "license": "MIT",
  "description": "Monorepo for @pineappleui — a presentational React design system.",
  "homepage": "https://github.com/davidz-repo/pineapple-design-systems#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidz-repo/pineapple-design-systems.git"
  },
  "bugs": {
    "url": "https://github.com/davidz-repo/pineapple-design-systems/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify": "turbo run build lint test typecheck && node scripts/check-publish-contract.mjs",
    "check:publish": "node scripts/check-publish-contract.mjs",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0",
    "turbo": "^2.3.0"
  }
}
