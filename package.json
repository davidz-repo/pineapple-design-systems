{
  "name": "pineapple-design-systems",
  "private": true,
  "license": "MIT",
  "description": "Monorepo for @pineappleui \u2014 a presentational React design system.",
  "homepage": "https://github.com/davidz-repo/pineapple-design-systems#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidz-repo/pineapple-design-systems.git"
  },
  "bugs": {
    "url": "https://github.com/davidz-repo/pineapple-design-systems/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0",
      "onFail": "warn"
    }
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:scripts": "eslint scripts eslint.config.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify": "node scripts/check-toolchain-hoist.mjs && node scripts/check-toolchain-agreement.mjs && node scripts/check-alias-fences.mjs && node scripts/check-ci-invariants.mjs && node scripts/check-ref-tests.mjs && node scripts/check-peer-placement.mjs && turbo run build lint test typecheck && node scripts/check-publish-contract.mjs && node scripts/check-token-drift.mjs && node scripts/check-peer-externals.mjs",
    "check:aliases": "node scripts/check-alias-fences.mjs",
    "check:ci": "node scripts/check-ci-invariants.mjs",
    "check:refs": "node scripts/check-ref-tests.mjs",
    "check:placement": "node scripts/check-peer-placement.mjs",
    "check:publish": "node scripts/check-publish-contract.mjs",
    "check:drift": "node scripts/check-token-drift.mjs",
    "check:externals": "node scripts/check-peer-externals.mjs",
    "check:hoist": "node scripts/check-toolchain-hoist.mjs",
    "check:agreement": "node scripts/check-toolchain-agreement.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --no-audit --no-fund",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0",
    "@pineappleui/eslint-config": "*",
    "eslint": "^10.1.0",
    "turbo": "^2.3.0",
    "vite": "^8.1.5"
  }
}
